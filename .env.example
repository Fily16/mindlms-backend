# === General ===
PROJECT_NAME="MindLMS - Detección Temprana de Salud Mental"
DEBUG=true

# === Security ===
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === MongoDB ===
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mindlms

# === PostgreSQL ===
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mindlms

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Moodle LMS ===
MOODLE_URL=http://localhost:8081
MOODLE_TOKEN=your-moodle-ws-token-here
MOODLE_WEBHOOK_SECRET=change-this-webhook-secret

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# === ML Model ===
MODEL_PATH=ml/data/models
MODEL_NAME=roberta-mental-health

# === Detección pausada ===
# Segundos de espera tras cada texto NUEVO analizado (~3 textos por
# estudiante → 40s = un estudiante nuevo cada ~2 min en el dashboard).
# Poner 0 para analizar sin pausa.
DETECTION_PACE_SECONDS=40

# === Entrenamiento automático ===
# Entrena el baseline al arrancar si no existe modelo (sin botón en la UI)
AUTO_TRAIN_ON_STARTUP=true
